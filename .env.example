# Azure OpenAI resource endpoint.
# Use the root URL without /openai/v1 or a deployment path.
# Example: https://your-resource.openai.azure.com
AZURE_OPENAI_ENDPOINT=

# API key from the same Azure OpenAI resource.
# Used by both the embedding and chat deployments.
AZURE_OPENAI_API_KEY=

# Embedding deployment name, not the underlying model name.
# Example: rag-embedding
AZURE_OPENAI_EMBEDDING_DEPLOYMENT=

# Chat deployment name used to generate document-based answers.
# Example: rag-chat
AZURE_OPENAI_CHAT_DEPLOYMENT=


# Azure AI Search service endpoint.
# Example: https://your-search-service.search.windows.net
AZURE_SEARCH_ENDPOINT=

# Azure AI Search admin key used to create the index and upload chunks.
AZURE_SEARCH_API_KEY=

# Search index containing document chunks, metadata, and vectors.
# Use the exact index name configured in Azure.
AZURE_SEARCH_INDEX_NAME=


# Complete Blob Storage connection string, not just the account key.
# Copy from Storage account > Access keys > Connection string.
AZURE_STORAGE_CONNECTION_STRING=

# Private Blob container used to store original PDFs and text files.
# Example: documents
AZURE_STORAGE_CONTAINER_NAME=